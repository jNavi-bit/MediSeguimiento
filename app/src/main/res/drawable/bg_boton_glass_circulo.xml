<?xml version="1.0" encoding="utf-8"?>
<!-- Botón circular translúcido sobre el encabezado; el ripple queda recortado al círculo. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#40FFFFFF">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/hero_glass" />
            <stroke android:width="1dp" android:color="@color/hero_glass_stroke" />
        </shape>
    </item>
</ripple>
