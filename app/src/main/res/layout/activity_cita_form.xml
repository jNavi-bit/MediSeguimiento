<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- Barra superior -->
    <LinearLayout
        android:id="@+id/barra_superior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_s"
        android:paddingVertical="@dimen/space_xs">

        <ImageButton
            android:id="@+id/btn_cerrar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/ripple_circulo"
            android:contentDescription="@string/cerrar"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/titulo_barra"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:layout_weight="1"
            android:alpha="0"
            android:textAppearance="@style/TextAppearance.Medi.Title"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_gutter"
            android:paddingBottom="@dimen/space_xl">

            <TextView
                android:id="@+id/titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:accessibilityHeading="true"
                android:textAppearance="@style/TextAppearance.Medi.Display"
                android:textColor="?attr/colorOnSurface" />

            <!-- ¿Con quién? -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tarjeta_quien"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/screen_gutter">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_badge"
                        android:backgroundTint="@color/accent_agenda_bg">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_medical"
                            app:tint="@color/accent_agenda" />
                    </FrameLayout>

                    <TextView
                        style="@style/Medi.SeccionTitulo"
                        android:text="@string/form_seccion_quien" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_especialidad"
                    style="@style/Widget.Medi.TextInput.Desplegable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:hint="@string/campo_especialidad">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/et_especialidad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:completionThreshold="1"
                        android:imeOptions="actionNext"
                        android:inputType="textCapSentences"
                        android:maxLength="60" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_medico"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:hint="@string/campo_medico"
                    app:startIconDrawable="@drawable/ic_person">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_medico"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLength="60" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_lugar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:hint="@string/campo_lugar"
                    app:startIconDrawable="@drawable/ic_place">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_lugar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="textCapSentences"
                        android:maxLength="80" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ¿Cuándo? -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tarjeta_cuando"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/screen_gutter">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_badge"
                        android:backgroundTint="@color/accent_estudios_bg">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/accent_estudios" />
                    </FrameLayout>

                    <TextView
                        style="@style/Medi.SeccionTitulo"
                        android:text="@string/form_seccion_cuando" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_fecha"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/campo_fecha"
                        app:startIconDrawable="@drawable/ic_calendar">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_fecha"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:inputType="none"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <Space
                        android:layout_width="@dimen/space_m"
                        android:layout_height="0dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_hora"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/campo_hora"
                        app:startIconDrawable="@drawable/ic_clock">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_hora"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:inputType="none"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/campo_duracion"
                    android:textAppearance="@style/TextAppearance.Medi.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/grupo_duracion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    app:chipSpacingHorizontal="8dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip android:id="@+id/dur_15" style="@style/Widget.Medi.Chip.Filtro" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15 min" />
                    <com.google.android.material.chip.Chip android:id="@+id/dur_30" style="@style/Widget.Medi.Chip.Filtro" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="30 min" />
                    <com.google.android.material.chip.Chip android:id="@+id/dur_45" style="@style/Widget.Medi.Chip.Filtro" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="45 min" />
                    <com.google.android.material.chip.Chip android:id="@+id/dur_60" style="@style/Widget.Medi.Chip.Filtro" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 h" />
                    <com.google.android.material.chip.Chip android:id="@+id/dur_90" style="@style/Widget.Medi.Chip.Filtro" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 h 30 min" />
                    <com.google.android.material.chip.Chip android:id="@+id/dur_120" style="@style/Widget.Medi.Chip.Filtro" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2 h" />
                </com.google.android.material.chip.ChipGroup>

                <TextView
                    android:id="@+id/error_fecha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_l"
                    android:layout_marginTop="@dimen/space_xs"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="@style/TextAppearance.Medi.BodySmall"
                    android:textColor="?attr/colorError"
                    android:visibility="gone" />

                <com.google.android.material.chip.ChipGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    app:chipSpacingHorizontal="8dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_manana"
                        style="@style/Widget.Medi.Chip.Accion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rapido_manana" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_semana"
                        style="@style/Widget.Medi.Chip.Accion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rapido_semana" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_mes"
                        style="@style/Widget.Medi.Chip.Accion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rapido_mes" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Recordatorio -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tarjeta_recordatorio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/screen_gutter">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_badge"
                        android:backgroundTint="@color/accent_historial_bg">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_bell"
                            app:tint="@color/accent_historial" />
                    </FrameLayout>

                    <TextView
                        style="@style/Medi.SeccionTitulo"
                        android:text="@string/form_seccion_recordatorio" />
                </LinearLayout>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/grupo_recordatorio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    app:chipSpacingHorizontal="8dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/rec_ninguno"
                        style="@style/Widget.Medi.Chip.Filtro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/recordatorio_ninguno" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/rec_15"
                        style="@style/Widget.Medi.Chip.Filtro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/recordatorio_15" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/rec_60"
                        style="@style/Widget.Medi.Chip.Filtro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/recordatorio_60" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/rec_dia"
                        style="@style/Widget.Medi.Chip.Filtro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/recordatorio_dia" />
                </com.google.android.material.chip.ChipGroup>

                <TextView
                    android:id="@+id/rec_explicacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:layout_marginStart="@dimen/space_xs"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="@style/TextAppearance.Medi.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Notas -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tarjeta_notas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/screen_gutter">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_badge"
                        android:backgroundTint="@color/accent_prep_bg">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_edit_note"
                            app:tint="@color/accent_prep" />
                    </FrameLayout>

                    <TextView
                        style="@style/Medi.SeccionTitulo"
                        android:text="@string/form_seccion_notas" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_notas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:hint="@string/campo_notas"
                    app:counterEnabled="true"
                    app:counterMaxLength="500">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_notas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLength="500"
                        android:minLines="3" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_xs">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="2dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_info"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:layout_weight="1"
                    android:text="@string/aviso_cita_personal"
                    android:textAppearance="@style/TextAppearance.Medi.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Barra inferior -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant" />

    <FrameLayout
        android:id="@+id/barra_inferior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainerLowest"
        android:paddingHorizontal="@dimen/screen_gutter"
        android:paddingVertical="@dimen/space_m">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_guardar"
            style="@style/Widget.Medi.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:iconGravity="textStart"
            app:iconPadding="10dp" />
    </FrameLayout>
</LinearLayout>
