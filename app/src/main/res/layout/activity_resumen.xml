<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/space_xl">

                <LinearLayout
                    android:id="@+id/hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/screen_gutter"
                    android:paddingTop="@dimen/space_s"
                    android:paddingBottom="28dp">

                    <ImageButton
                        android:id="@+id/btn_volver"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_boton_glass_circulo"
                        android:contentDescription="@string/volver"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="@color/hero_on" />

                    <TextView
                        android:id="@+id/encabezado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_l"
                        android:textAppearance="@style/TextAppearance.Medi.Overline"
                        android:textColor="@color/hero_on_muted" />

                    <TextView
                        android:id="@+id/titulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:accessibilityHeading="true"
                        android:textAppearance="@style/TextAppearance.Medi.Display"
                        android:textColor="@color/hero_on" />

                    <TextView
                        android:id="@+id/generado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textAppearance="@style/TextAppearance.Medi.BodySmall"
                        android:textColor="@color/hero_on_muted" />

                    <TextView
                        android:id="@+id/completitud"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_l"
                        android:background="@drawable/bg_pill"
                        android:backgroundTint="@color/hero_glass"
                        android:drawablePadding="6dp"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:textAppearance="@style/TextAppearance.Medi.Label"
                        android:textColor="@color/hero_on"
                        android:textSize="12sp"
                        android:visibility="invisible"
                        app:drawableStartCompat="@drawable/ic_check_circle"
                        app:drawableTint="@color/hero_on" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/screen_gutter">

                    <LinearLayout
                        android:id="@+id/cargando"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="56dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:indeterminate="true"
                            app:indicatorColor="?attr/colorPrimary"
                            app:trackCornerRadius="3dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_l"
                            android:text="@string/resumen_generando"
                            android:textAppearance="@style/TextAppearance.Medi.Body"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/secciones"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/pie"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_l"
                        android:drawablePadding="8dp"
                        android:paddingHorizontal="@dimen/space_xs"
                        android:text="@string/resumen_pie"
                        android:textAppearance="@style/TextAppearance.Medi.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone"
                        app:drawableStartCompat="@drawable/ic_info"
                        app:drawableTint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant" />

        <LinearLayout
            android:id="@+id/barra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:background="?attr/colorSurfaceContainerLowest"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_gutter"
            android:paddingTop="@dimen/space_s"
            android:paddingBottom="@dimen/space_m">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_consentimiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:text="@string/resumen_consentimiento"
                android:textAppearance="@style/TextAppearance.Medi.BodySmall"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_destinatario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:hint="@string/resumen_destinatario"
                android:visibility="gone"
                app:startIconDrawable="@drawable/ic_person">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_destinatario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="80" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_copiar"
                    style="@style/Widget.Medi.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_m"
                    android:layout_weight="1"
                    android:text="@string/copiar"
                    app:icon="@drawable/ic_copy"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_compartir"
                    style="@style/Widget.Medi.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    android:text="@string/compartir"
                    app:icon="@drawable/ic_share"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
