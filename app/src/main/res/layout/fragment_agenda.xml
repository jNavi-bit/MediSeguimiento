<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/encabezado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_gutter"
            android:paddingTop="@dimen/space_xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/agenda_titulo"
                    android:textAppearance="@style/TextAppearance.Medi.Display"
                    android:textColor="?attr/colorOnSurface" />

                <LinearLayout
                    android:id="@+id/selector_vista"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:background="@drawable/bg_segment_track"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <ImageButton
                        android:id="@+id/btn_vista_lista"
                        android:layout_width="44dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_segmento_sel"
                        android:contentDescription="@string/vista_lista"
                        android:src="@drawable/ic_view_list" />

                    <ImageButton
                        android:id="@+id/btn_vista_calendario"
                        android:layout_width="44dp"
                        android:layout_height="38dp"
                        android:background="@drawable/ripple_pill"
                        android:contentDescription="@string/vista_calendario"
                        android:src="@drawable/ic_view_day" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/agenda_subtitulo"
                    android:textAppearance="@style/TextAppearance.Medi.Body"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/mes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:textAppearance="@style/TextAppearance.Medi.Label"
                    android:textColor="?attr/colorPrimary" />
            </LinearLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:overScrollMode="never"
            android:paddingHorizontal="@dimen/screen_gutter" />

        <HorizontalScrollView
            android:id="@+id/filtros_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="@dimen/screen_gutter"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/filtros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_proximas"
                    style="@style/Widget.Medi.Chip.Filtro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/filtro_proximas" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_pasadas"
                    style="@style/Widget.Medi.Chip.Filtro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filtro_pasadas" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_canceladas"
                    style="@style/Widget.Medi.Chip.Filtro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filtro_canceladas" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lista"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/screen_gutter"
                android:paddingBottom="104dp" />

            <!-- Vista de calendario por horas: título fijo y día desplazable -->
            <LinearLayout
                android:id="@+id/calendario_contenedor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/calendario_titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:paddingHorizontal="@dimen/screen_gutter"
                    android:paddingTop="@dimen/space_l"
                    android:paddingBottom="@dimen/space_s"
                    android:textAppearance="@style/TextAppearance.Medi.Label"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/calendario_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="104dp">

                    <com.mediseguimiento.app.ui.agenda.VistaDiaView
                        android:id="@+id/vista_dia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingEnd="4dp" />
                </androidx.core.widget.NestedScrollView>
            </LinearLayout>

            <androidx.core.widget.NestedScrollView
                android:id="@+id/vacio_contenedor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/screen_gutter"
                android:paddingTop="@dimen/space_l"
                android:paddingBottom="104dp"
                android:visibility="gone">

                <include
                    android:id="@+id/vacio"
                    layout="@layout/view_estado_vacio" />
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab"
        style="@style/Widget.Medi.Fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/screen_gutter"
        android:text="@string/nueva_cita"
        app:icon="@drawable/ic_add" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
