<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_gutter"
        android:paddingBottom="@dimen/space_xxl">

        <LinearLayout
            android:id="@+id/encabezado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_xl"
            android:paddingBottom="@dimen/space_xl">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/perfil_titulo"
                android:textAppearance="@style/TextAppearance.Medi.Display"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/perfil_subtitulo"
                android:textAppearance="@style/TextAppearance.Medi.Body"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- Tarjeta de identidad -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:shapeAppearance="@style/Shape.Medi.Large">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <View
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-70dp"
                    android:layout_marginEnd="-50dp"
                    android:alpha="0.5"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="?attr/colorPrimaryContainer" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/screen_gutter">

                    <TextView
                        android:id="@+id/avatar"
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:background="@drawable/bg_avatar"
                        android:elevation="6dp"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:textAppearance="@style/TextAppearance.Medi.Headline"
                        android:textColor="@color/hero_on" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_l"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/nombre"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.Medi.Title"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="19sp" />

                        <TextView
                            android:id="@+id/correo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.Medi.BodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/miembro"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:background="@drawable/bg_pill"
                            android:backgroundTint="?attr/colorPrimaryContainer"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:textAppearance="@style/TextAppearance.Medi.Label"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/space_l">

                    <TextView
                        android:id="@+id/stat_proximas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textAppearance="@style/TextAppearance.Medi.Headline"
                        android:textColor="@color/accent_agenda"
                        android:textSize="28sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stat_proximas"
                        android:textAppearance="@style/TextAppearance.Medi.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="@dimen/space_m"
                android:layout_height="0dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/space_l">

                    <TextView
                        android:id="@+id/stat_estudios"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textAppearance="@style/TextAppearance.Medi.Headline"
                        android:textColor="@color/accent_estudios"
                        android:textSize="28sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stat_estudios"
                        android:textAppearance="@style/TextAppearance.Medi.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="@dimen/space_m"
                android:layout_height="0dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/space_l">

                    <TextView
                        android:id="@+id/stat_preparadas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textAppearance="@style/TextAppearance.Medi.Headline"
                        android:textColor="@color/accent_prep"
                        android:textSize="28sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stat_preparadas"
                        android:textAppearance="@style/TextAppearance.Medi.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="@dimen/space_m"
            android:accessibilityHeading="true"
            android:text="@string/perfil_seccion_privacidad"
            android:textAppearance="@style/TextAppearance.Medi.Title"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/lista_privacidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/divisor_inset"
                android:orientation="vertical"
                android:showDividers="middle">

                <include android:id="@+id/fila_local" layout="@layout/item_fila_info" />
                <include android:id="@+id/fila_hash" layout="@layout/item_fila_info" />
                <include android:id="@+id/fila_consent" layout="@layout/item_fila_info" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cerrar_sesion"
            style="@style/Widget.Medi.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/cerrar_sesion"
            android:textColor="?attr/colorError"
            app:icon="@drawable/ic_logout"
            app:iconGravity="textStart"
            app:iconTint="?attr/colorError"
            app:rippleColor="?attr/colorErrorContainer" />

        <TextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Medi.BodySmall"
            android:textColor="?attr/colorOutline" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
