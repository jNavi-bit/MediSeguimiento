<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== Formas ===== -->
    <style name="Shape.Medi.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_s</item>
    </style>
    <style name="Shape.Medi.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_m</item>
    </style>
    <style name="Shape.Medi.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_l</item>
    </style>
    <style name="Shape.Medi.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- ===== Tipografía ===== -->
    <style name="TextAppearance.Medi.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">30sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingExtra">2sp</item>
    </style>
    <style name="TextAppearance.Medi.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="TextAppearance.Medi.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.Medi.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">3sp</item>
        <item name="android:letterSpacing">0.005</item>
    </style>
    <style name="TextAppearance.Medi.BodySmall" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">2sp</item>
    </style>
    <style name="TextAppearance.Medi.Overline" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="TextAppearance.Medi.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="TextAppearance.Medi.NavLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- ===== Componentes ===== -->
    <style name="Widget.Medi.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLowest</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
        <item name="shapeAppearance">@style/Shape.Medi.Medium</item>
    </style>

    <style name="Widget.Medi.Card.Tinted" parent="Widget.Medi.Card">
        <item name="cardBackgroundColor">?attr/colorPrimaryContainer</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.Medi.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Medi.Label</item>
        <item name="shapeAppearance">@style/Shape.Medi.Pill</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Medi.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Medi.Label</item>
        <item name="shapeAppearance">@style/Shape.Medi.Pill</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Medi.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Medi.Label</item>
        <item name="shapeAppearance">@style/Shape.Medi.Pill</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Medi.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAppearance">@style/TextAppearance.Medi.Label</item>
        <item name="shapeAppearance">@style/Shape.Medi.Pill</item>
    </style>

    <style name="Widget.Medi.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_s</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_s</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_s</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_s</item>
        <item name="boxStrokeColor">@color/text_input_stroke</item>
        <item name="boxBackgroundColor">?attr/colorSurfaceContainerLowest</item>
        <item name="boxBackgroundMode">outline</item>
    </style>

    <style name="Widget.Medi.TextInput.Desplegable" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">@dimen/radius_s</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_s</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_s</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_s</item>
        <item name="boxStrokeColor">@color/text_input_stroke</item>
        <item name="boxBackgroundColor">?attr/colorSurfaceContainerLowest</item>
    </style>

    <!-- Encabezado de sección dentro de una tarjeta de formulario -->
    <style name="Medi.SeccionTitulo" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">@dimen/space_m</item>
        <item name="android:textAppearance">@style/TextAppearance.Medi.Title</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:accessibilityHeading">true</item>
    </style>

    <style name="Widget.Medi.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">?attr/colorSurfaceContainerLowest</item>
        <item name="itemIconTint">@color/nav_item</item>
        <item name="itemTextColor">@color/nav_item</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Medi.BottomNav.Indicator</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Medi.NavLabel</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Medi.NavLabel</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.Medi.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorPrimaryContainer</item>
        <item name="android:width">64dp</item>
        <item name="android:height">32dp</item>
    </style>


    <!-- ===== Chips de filtro ===== -->
    <style name="Widget.Medi.Chip.Filtro" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_fondo</item>
        <item name="android:textColor">@color/chip_texto</item>
        <item name="chipStrokeColor">@color/chip_borde</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
        <item name="chipMinHeight">40dp</item>
        <item name="chipStartPadding">10dp</item>
        <item name="chipEndPadding">10dp</item>
        <item name="shapeAppearance">@style/Shape.Medi.Pill</item>
        <item name="android:textAppearance">@style/TextAppearance.Medi.Label</item>
        <item name="rippleColor">?attr/colorControlHighlight</item>
    </style>

    <style name="Widget.Medi.Chip.Accion" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">?attr/colorSurfaceContainerLowest</item>
        <item name="chipStrokeColor">?attr/colorOutlineVariant</item>
        <item name="chipIconTint">?attr/colorPrimary</item>
        <item name="chipMinHeight">36dp</item>
        <item name="shapeAppearance">@style/Shape.Medi.Pill</item>
        <item name="android:textAppearance">@style/TextAppearance.Medi.Label</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.Medi.Fab" parent="Widget.Material3.ExtendedFloatingActionButton.Icon.Primary">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="iconTint">?attr/colorOnPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textAppearance">@style/TextAppearance.Medi.Label</item>
        <item name="shapeAppearance">@style/Shape.Medi.Medium</item>
        <item name="elevation">6dp</item>
    </style>

    <!-- ===== Diálogos ===== -->
    <style name="ThemeOverlay.Medi.Dialogo" parent="ThemeOverlay.Material3.MaterialAlertDialog.Centered">
        <item name="alertDialogStyle">@style/Medi.Dialogo.Fondo</item>
        <item name="colorPrimary">@color/md_primary</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Medi.Dialogo.Titulo</item>
        <item name="buttonBarPositiveButtonStyle">@style/Medi.Dialogo.Boton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Medi.Dialogo.Boton</item>
    </style>

    <!-- Variante para acciones destructivas: ícono y botón principal en color de error. -->
    <style name="ThemeOverlay.Medi.Dialogo.Destructivo">
        <item name="buttonBarPositiveButtonStyle">@style/Medi.Dialogo.Boton.Destructivo</item>
        <item name="colorSecondary">@color/md_error</item>
    </style>

    <style name="Medi.Dialogo.Fondo" parent="MaterialAlertDialog.Material3">
        <item name="backgroundTint">?attr/colorSurfaceContainerLowest</item>
        <item name="shapeAppearance">@style/Shape.Medi.Large</item>
    </style>

    <style name="Medi.Dialogo.Titulo" parent="MaterialAlertDialog.Material3.Title.Text.CenterStacked">
        <item name="android:textAppearance">@style/TextAppearance.Medi.Headline</item>
    </style>

    <style name="Medi.Dialogo.Boton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textAppearance">@style/TextAppearance.Medi.Label</item>
        <item name="shapeAppearance">@style/Shape.Medi.Pill</item>
    </style>

    <style name="Medi.Dialogo.Boton.Destructivo">
        <item name="android:textColor">?attr/colorError</item>
        <item name="rippleColor">?attr/colorErrorContainer</item>
    </style>

</resources>
